#!/usr/bin/env bash
set -euo pipefail

# Lightweight agent-to-agent messages for Herdr.
# Default contract: deliver -> print small receipt -> stop / end turn.
# No msg_id, sentinels, wait-reply, or verify. The peer push-replies into reply-to.

usage() {
  cat <<'EOF'
Usage: scripts/herdr-msg <target> [--task id] [--kind request|reply|update] [--] [message...]

Sends a one-line herdr-msg header plus body to another Herdr agent/pane via
`herdr pane run`, then exits. Message text may be argv or stdin.

Default header (minimal):
  [herdr-msg reply-to:<self-pane> task:<task>]
  <body>

Optional: --kind request|reply|update (included in header when not "request")
  HERDR_AGENT_NAME / detected agent name adds from:<name> when available.

After a successful send: stop. Do not poll the target. Do not block-wait.
When the peer injects a reply into your pane, handle that inbound message.

Options:
  --task id          Human thread label (default: general)
  --kind KIND        request|reply|update (default: request)
  --allow-self       Allow sending a request to your own pane (default: refuse)
  --dry-run          Print payload and receipt; do not send
  --quiet            Suppress receipt on stdout
  -h, --help         Show this help

Receipt (stdout, unless --quiet):
  ok state target target_pane reply_to task kind hint

Exit codes:
  0  delivered (or dry-run)
  1  send / resolve failure
  2  usage / environment / self-target refuse / empty body
EOF
}

require_opt_value() {
  local opt="$1"
  if [[ $# -lt 2 || -z "${2}" || "${2}" == --* ]]; then
    echo "error: missing value for ${opt}" >&2
    exit 2
  fi
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 2
fi

target=$1
shift
task="general"
kind="request"
dry_run=0
quiet=0
allow_self=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --task)
      require_opt_value "$1" "${2:-}"
      task="$2"
      shift 2
      ;;
    --kind)
      require_opt_value "$1" "${2:-}"
      kind="$2"
      shift 2
      ;;
    --allow-self)
      allow_self=1
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --quiet)
      quiet=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "error: unknown option: $1" >&2
      echo "error: lightweight mode supports --task --kind --allow-self --dry-run --quiet" >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

case "$kind" in
  request|reply|update) ;;
  *)
    echo "error: --kind must be request, reply, or update (got: ${kind})" >&2
    exit 2
    ;;
esac

# Reject newlines/control chars in task (keep header one line).
if [[ "$task" == *$'\n'* || "$task" == *$'\r'* || "$task" == *']'* ]]; then
  echo "error: --task must be a single line without ] or newlines" >&2
  exit 2
fi
if [[ -z "${task//[[:space:]]/}" ]]; then
  echo "error: --task is empty" >&2
  exit 2
fi
# Collapse internal whitespace for a stable header token.
task_value=$(printf '%s' "$task" | tr -s '[:space:]' '-')
task_value=${task_value//]/}
task_value=${task_value//]/-}
if [[ -z "$task_value" ]]; then
  task_value="general"
fi

if [[ $# -gt 0 ]]; then
  body="$*"
elif [[ ! -t 0 ]]; then
  body=$(cat)
else
  echo "error: message body required on argv or stdin" >&2
  exit 2
fi

if [[ -z "${body//[[:space:]]/}" ]]; then
  echo "error: message body is empty" >&2
  exit 2
fi

if [[ "${HERDR_ENV:-}" != "1" ]]; then
  echo "error: HERDR_ENV is not 1; refusing to control live Herdr panes" >&2
  exit 2
fi

json_string_field() {
  local json="$1"
  local key="$2"
  local pattern="\"${key}\":\"([^\"]*)\""
  if [[ "$json" =~ $pattern ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  fi
}

strip_simple_agent_session() {
  local json="$1"
  local pattern='"agent_session":\{[^{}]*\},?'
  while [[ "$json" =~ $pattern ]]; do
    json="${json/${BASH_REMATCH[0]}/}"
  done
  printf '%s' "$json"
}

pane_object_with_focused() {
  local json="$1"
  local pattern='\{[^{}]*"focused":true[^{}]*\}'
  if [[ "$json" =~ $pattern ]]; then
    printf '%s' "${BASH_REMATCH[0]}"
  fi
}

pane_object_with_pane_id() {
  local json="$1"
  local pane_id="$2"
  local pattern="\{[^{}]*\"pane_id\":\"${pane_id}\"[^{}]*\}"
  if [[ "$json" =~ $pattern ]]; then
    printf '%s' "${BASH_REMATCH[0]}"
  fi
}

pane_object_with_terminal_id() {
  local json="$1"
  local terminal_id="$2"
  local pattern="\{[^{}]*\"terminal_id\":\"${terminal_id}\"[^{}]*\}"
  if [[ "$json" =~ $pattern ]]; then
    printf '%s' "${BASH_REMATCH[0]}"
  fi
}

first_pane_object() {
  local json="$1"
  local pattern='\{[^{}]*"pane_id":"[^"]*"[^{}]*\}'
  if [[ "$json" =~ $pattern ]]; then
    printf '%s' "${BASH_REMATCH[0]}"
  fi
}

# Resolve handle (agent name, pane_id, terminal_id) to canonical pane_id.
resolve_canonical_pane_id() {
  local handle="$1"
  local list_json="${2:-}"
  local info pid obj
  if [[ -z "$handle" ]]; then
    return 0
  fi
  info=$(herdr agent get "$handle" 2>/dev/null || true)
  info=$(strip_simple_agent_session "$info")
  pid=$(json_string_field "$info" pane_id)
  if [[ -n "$pid" ]]; then
    printf '%s' "$pid"
    return 0
  fi
  info=$(herdr pane get "$handle" 2>/dev/null || true)
  info=$(strip_simple_agent_session "$info")
  pid=$(json_string_field "$info" pane_id)
  if [[ -n "$pid" ]]; then
    printf '%s' "$pid"
    return 0
  fi
  if [[ -n "$list_json" ]]; then
    obj=$(pane_object_with_pane_id "$list_json" "$handle")
    pid=$(json_string_field "$obj" pane_id)
    if [[ -n "$pid" ]]; then
      printf '%s' "$pid"
      return 0
    fi
    obj=$(pane_object_with_terminal_id "$list_json" "$handle")
    pid=$(json_string_field "$obj" pane_id)
    if [[ -n "$pid" ]]; then
      printf '%s' "$pid"
      return 0
    fi
  fi
}

print_receipt() {
  if [[ "$quiet" -eq 1 ]]; then
    return 0
  fi
  local state="$1"
  local ok_flag=1
  if [[ "$state" == "error" ]]; then
    ok_flag=0
  fi
  cat <<EOF
ok=${ok_flag}
state=${state}
target=${target}
target_pane=${target_pane_id}
reply_to=${reply_to}
task=${task_value}
kind=${kind}
hint=${receipt_hint}
EOF
}

info_json=$(herdr pane list)
info_without_sessions=$(strip_simple_agent_session "$info_json")

# SELF: prefer HERDR_PANE_ID handle for APIs; canonicalize for comparisons / header.
canonical_self=""
if [[ -n "${HERDR_PANE_ID:-}" ]]; then
  canonical_self=$(resolve_canonical_pane_id "$HERDR_PANE_ID" "$info_without_sessions")
fi

source_json=""
if [[ -n "$canonical_self" ]]; then
  source_json=$(pane_object_with_pane_id "$info_without_sessions" "$canonical_self")
fi
if [[ -z "$(json_string_field "$source_json" pane_id)" && -n "${HERDR_PANE_ID:-}" ]]; then
  source_json=$(strip_simple_agent_session "$(herdr pane get "$HERDR_PANE_ID" 2>/dev/null || true)")
fi
if [[ -z "$(json_string_field "$source_json" pane_id)" ]]; then
  source_json=$(pane_object_with_focused "$info_without_sessions")
fi
if [[ -z "$(json_string_field "$source_json" pane_id)" ]]; then
  source_json=$(first_pane_object "$info_without_sessions")
fi
if [[ -z "$canonical_self" ]]; then
  canonical_self=$(json_string_field "$source_json" pane_id)
fi

# reply-to: canonical pane id when known (stable for peers); else env handle.
reply_to="${canonical_self:-${HERDR_PANE_ID:-}}"
if [[ -z "$reply_to" ]]; then
  echo "error: could not resolve self pane (set HERDR_PANE_ID)" >&2
  exit 1
fi

from_name="${HERDR_AGENT_NAME:-$(json_string_field "$source_json" agent)}"
if [[ -z "$from_name" ]]; then
  from_name=$(json_string_field "$source_json" label)
fi

# Build one-line header. Always: reply-to + task. Optional: from, kind.
header="[herdr-msg"
if [[ -n "$from_name" ]]; then
  # scrub ] and whitespace for one-line safety
  from_clean=${from_name//]/-}
  from_clean=$(printf '%s' "$from_clean" | tr -s '[:space:]' '-')
  header="${header} from:${from_clean}"
fi
header="${header} reply-to:${reply_to} task:${task_value}"
if [[ "$kind" != "request" ]]; then
  header="${header} kind:${kind}"
fi
header="${header}]"

payload="${header}"$'\n'"${body}"

target_pane_id=$(resolve_canonical_pane_id "$target" "$info_without_sessions")
if [[ -z "$target_pane_id" ]]; then
  echo "error: could not resolve target agent or pane: $target" >&2
  exit 1
fi

if [[ "$target_pane_id" == "$canonical_self" && "$kind" == "request" && "$allow_self" -eq 0 ]]; then
  echo "error: refusing request to self (${target_pane_id}); use another agent or --allow-self" >&2
  exit 2
fi

receipt_hint="End turn. Do not poll the target. Do not block-wait. Handle the inbound reply when it is injected into your pane."

if [[ "$dry_run" -eq 1 ]]; then
  if [[ "$quiet" -eq 0 ]]; then
    printf 'payload<<EOF\n%s\nEOF\n' "$payload"
  fi
  receipt_hint="DRY-RUN only. Nothing was sent. ${receipt_hint}"
  print_receipt "dry-run"
  exit 0
fi

if ! herdr pane run "$target_pane_id" "$payload"; then
  echo "error: herdr pane run failed for target pane: $target_pane_id" >&2
  receipt_hint="SEND failed. Fix the target and resend. Do not poll."
  print_receipt "error" || true
  exit 1
fi

print_receipt "delivered"
exit 0
